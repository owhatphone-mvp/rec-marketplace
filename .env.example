PORT=3000
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_KEY=admin-demo-key
REC_PRICE_THB=40
CURRENCY=THB
TREASURY_REC=1000000
PAYMENT_MODE=mock
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
AML_REVIEW_THRESHOLD=5000000

# ---- PaySolutions (Payso) — PromptPay REST API ----
# set PAYMENT_MODE=paysolutions to enable
PAYSOLUTIONS_MERCHANT_ID= # 8-digit merchant id
PAYSOLUTIONS_BEARER= # Bearer token for PromptPay API
PAYSOLUTIONS_API_KEY= # apikey for Inquiry API (ask Payso staff)
PAYSOLUTIONS_SECRET_KEY= # secretkey for Inquiry API (ask Payso staff)
PAYSOLUTIONS_BASE=https://apis.paysolutions.asia
PUBLIC_BASE_URL=https://market.rectokenasean.com

# ---- SMTP: ลืมรหัสผ่าน (ส่งเมลผ่าน Gmail / Google Workspace ของ info@) ----
# ถ้าไม่ตั้ง SMTP_USER/SMTP_PASS ระบบจะ log ลิงก์รีเซ็ตออก console แทนการส่งจริง
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@rectokenasean.com
SMTP_PASS= # Gmail App Password 16 หลัก (อย่า commit ค่าจริง — ใส่ใน Railway Variables)
SMTP_FROM=info@rectokenasean.com
